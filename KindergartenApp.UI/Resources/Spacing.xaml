<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Spacing System -->
    <system:Double x:Key="Spacing2XS">4</system:Double>
    <system:Double x:Key="SpacingXS">8</system:Double>
    <system:Double x:Key="SpacingSM">12</system:Double>
    <system:Double x:Key="SpacingMD">16</system:Double>
    <system:Double x:Key="SpacingLG">24</system:Double>
    <system:Double x:Key="SpacingXL">32</system:Double>
    <system:Double x:Key="Spacing2XL">48</system:Double>

    <!-- Thickness -->
    <Thickness x:Key="Margin2XS">4</Thickness>
    <Thickness x:Key="MarginXS">8</Thickness>
    <Thickness x:Key="MarginSM">12</Thickness>
    <Thickness x:Key="MarginMD">16</Thickness>
    <Thickness x:Key="MarginLG">24</Thickness>
    <Thickness x:Key="MarginXL">32</Thickness>

    <Thickness x:Key="Padding2XS">4</Thickness>
    <Thickness x:Key="PaddingXS">8</Thickness>
    <Thickness x:Key="PaddingSM">12</Thickness>
    <Thickness x:Key="PaddingMD">16</Thickness>
    <Thickness x:Key="PaddingLG">24</Thickness>
    <Thickness x:Key="PaddingXL">32</Thickness>

    <!-- Border Radius -->
    <CornerRadius x:Key="CornerRadiusSM">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMD">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLG">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXL">16</CornerRadius>

    <!-- Border Thickness -->
    <system:Double x:Key="BorderThicknessThin">1</system:Double>
    <system:Double x:Key="BorderThicknessNormal">2</system:Double>

</ResourceDictionary>
