<UserControl x:Class="KindergartenApp.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Background="{StaticResource BrushBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource CardModern}"
                Background="{StaticResource BrushSurface}"
                Margin="0,0,20,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="{StaticResource PaddingMD}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <materialDesign:PackIcon Kind="FileChartOutline"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="{StaticResource BrushPrimary}"
                                                 Margin="0,0,10,0" />
                        <TextBlock Text="Reports" Style="{StaticResource TextBlockH3}" />
                    </StackPanel>

                    <TextBlock Text="Unpaid Children Report" Style="{StaticResource TextBlockLabel}" Margin="0,0,0,6" />
                    <TextBlock Text="Generate PDF report of all children with unpaid fees"
                               Style="{StaticResource TextBlockBodySmall}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,0,0,10" />
                    <Button Command="{Binding GenerateUnpaidChildrenReportCommand}"
                            Height="42"
                            Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilePdfBoxOutline" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="Generate Report" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Monthly Revenue Report" Style="{StaticResource TextBlockLabel}" Margin="0,0,0,6" />
                    <TextBlock Text="Generate PDF report of monthly revenue"
                               Style="{StaticResource TextBlockBodySmall}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Month" Style="{StaticResource TextBlockLabelSmall}" Margin="0,0,0,6" />
                    <ComboBox SelectedItem="{Binding SelectedMonth}"
                              Style="{StaticResource ComboBoxModern}"
                              Margin="0,0,0,10">
                        <ComboBoxItem Content="January" Tag="1" />
                        <ComboBoxItem Content="February" Tag="2" />
                        <ComboBoxItem Content="March" Tag="3" />
                        <ComboBoxItem Content="April" Tag="4" />
                        <ComboBoxItem Content="May" Tag="5" />
                        <ComboBoxItem Content="June" Tag="6" />
                        <ComboBoxItem Content="July" Tag="7" />
                        <ComboBoxItem Content="August" Tag="8" />
                        <ComboBoxItem Content="September" Tag="9" />
                        <ComboBoxItem Content="October" Tag="10" />
                        <ComboBoxItem Content="November" Tag="11" />
                        <ComboBoxItem Content="December" Tag="12" />
                    </ComboBox>
                    <TextBlock Text="Year" Style="{StaticResource TextBlockLabelSmall}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding SelectedYear}" Style="{StaticResource TextBoxModern}" Margin="0,0,0,10" />
                    <Button Command="{Binding GenerateMonthlyRevenueReportCommand}"
                            Height="42"
                            Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcelBoxOutline" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="Generate Report" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Attendance Report" Style="{StaticResource TextBlockLabel}" Margin="0,0,0,6" />
                    <TextBlock Text="Generate PDF report of child attendance"
                               Style="{StaticResource TextBlockBodySmall}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Select Child" Style="{StaticResource TextBlockLabelSmall}" Margin="0,0,0,6" />
                    <ComboBox SelectedItem="{Binding SelectedChildId}"
                              ItemsSource="{Binding Children}"
                              DisplayMemberPath="FullName"
                              SelectedValuePath="Id"
                              Style="{StaticResource ComboBoxModern}"
                              Margin="0,0,0,10" />
                    <TextBlock Text="From Date" Style="{StaticResource TextBlockLabelSmall}" Margin="0,0,0,6" />
                    <DatePicker SelectedDate="{Binding FromDate}" Style="{StaticResource DatePickerModern}" Margin="0,0,0,10" />
                    <TextBlock Text="To Date" Style="{StaticResource TextBlockLabelSmall}" Margin="0,0,0,6" />
                    <DatePicker SelectedDate="{Binding ToDate}" Style="{StaticResource DatePickerModern}" Margin="0,0,0,10" />
                    <Button Command="{Binding GenerateAttendanceReportCommand}"
                            Height="42"
                            Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilePdfBoxOutline" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="Generate Report" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding LoadChildrenCommand}"
                            Style="{StaticResource ButtonSecondary}"
                            Height="42">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardModern}" Background="{StaticResource BrushSurface}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{StaticResource PaddingXL}">
                <materialDesign:PackIcon Kind="FileChartOutline"
                                         Width="64"
                                         Height="64"
                                         Foreground="{StaticResource BrushPrimary}"
                                         Margin="0,0,0,16" />
                <TextBlock Text="Reports Center"
                           Style="{StaticResource TextBlockH3}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBlock Text="Select a report type from the left panel to generate reports"
                           Style="{StaticResource TextBlockBody}"
                           Foreground="{StaticResource BrushTextSecondary}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>