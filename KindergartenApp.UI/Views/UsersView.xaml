<UserControl x:Class="KindergartenApp.UI.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:core="clr-namespace:KindergartenApp.Core.Entities;assembly=KindergartenApp.Core">
    <Grid Background="{StaticResource BrushBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource CardModern}"
                Background="{StaticResource BrushSurface}"
                Margin="0,0,20,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="{StaticResource PaddingMD}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <materialDesign:PackIcon Kind="AccountKeyOutline"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="{StaticResource BrushPrimary}"
                                                 Margin="0,0,10,0" />
                        <TextBlock Margin="0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockH3}">
                                    <Setter Property="Text" Value="Add User" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Text" Value="Update User" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="Username" Style="{StaticResource TextBlockLabel}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxModern}" Margin="0,0,0,14" />

                    <TextBlock Text="Email" Style="{StaticResource TextBlockLabel}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxModern}" Margin="0,0,0,14" />

                    <TextBlock Text="Full Name" Style="{StaticResource TextBlockLabel}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxModern}" Margin="0,0,0,14" />

                    <TextBlock Text="Role" Style="{StaticResource TextBlockLabel}" Margin="0,0,0,6" />
                    <ComboBox SelectedItem="{Binding Role}" Style="{StaticResource ComboBoxModern}" Margin="0,0,0,14">
                        <core:UserRole>Admin</core:UserRole>
                        <core:UserRole>Teacher</core:UserRole>
                        <core:UserRole>Accountant</core:UserRole>
                        <core:UserRole>Receptionist</core:UserRole>
                    </ComboBox>

                    <TextBlock Text="Staff Member" Style="{StaticResource TextBlockLabel}" Margin="0,0,0,6" />
                    <ComboBox SelectedValue="{Binding StaffId}" 
                              SelectedValuePath="Id" 
                              DisplayMemberPath="FullName"
                              ItemsSource="{Binding Staff}"
                              Style="{StaticResource ComboBoxModern}"
                              Margin="0,0,0,14" />

                    <TextBlock Text="Password" Style="{StaticResource TextBlockLabel}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource TextBoxModern}" Margin="0,0,0,14" />

                    <TextBlock Text="Confirm Password" Style="{StaticResource TextBlockLabel}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource TextBoxModern}" Margin="0,0,0,14" />

                    <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,0,0,18" />

                    <Button Command="{Binding AddUserCommand}"
                            Height="42"
                            Margin="0,0,0,10"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlusCircleOutline" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="Add User" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding UpdateUserCommand}"
                            Height="42"
                            Margin="0,0,0,10"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveEditOutline" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="Update User" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding LoadUsersCommand}"
                            Style="{StaticResource ButtonSecondary}"
                            Height="42"
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CancelEditCommand}"
                            Style="{StaticResource ButtonSecondary}"
                            Height="42"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloseCircleOutline" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardModern}" Background="{StaticResource BrushSurface}" Margin="0,0,0,16">
                <Grid Margin="{StaticResource PaddingMD}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBoxModern}"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource BrushTextPrimary}"
                             CaretBrush="{StaticResource BrushPrimary}"
                             materialDesign:HintAssist.Hint="Search by username, name, or email" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardModern}" Background="{StaticResource BrushSurface}" Padding="0">
                <DataGrid ItemsSource="{Binding FilteredUsers}" CellStyle="{StaticResource DataGridCellModern}"
                          SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="1.2*" />
                        <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="1.3*" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*" />
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120" />
                        <DataGridTextColumn Header="Staff" Binding="{Binding StaffName}" Width="1.2*" />
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                        <DataGridTemplateColumn Header="Actions" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource ButtonIcon}"
                                                MinHeight="32"
                                                MinWidth="32"
                                                ToolTip="Edit">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="17" Height="17" />
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource ButtonIcon}"
                                                MinHeight="32"
                                                MinWidth="32"
                                                ToolTip="Delete">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="17" Height="17" Foreground="{StaticResource BrushDanger}" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
