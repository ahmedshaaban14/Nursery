<UserControl x:Class="KindergartenApp.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Overview" Style="{StaticResource TextBlockH2}" Margin="0,0,0,4" />
                <TextBlock Text="A quick read on children, attendance, unpaid fees, and monthly income."
                           Style="{StaticResource TextBlockSmall}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding LoadDashboardCommand}" 
                        Style="{StaticResource ButtonPrimary}"
                        Height="40" 
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding BackupCommand}" Style="{StaticResource ButtonSecondary}" Height="40">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DatabaseExportOutline" Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock Text="Backup" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,14,0">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="AccountChildOutline" Width="26" Height="26" Foreground="{StaticResource BrushPrimary}" />
                            <TextBlock Text="Total Children" Style="{StaticResource TextBlockSmall}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding DashboardData.TotalChildren}" FontSize="32" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="0,0,14,0">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="CalendarCheckOutline" Width="26" Height="26" Foreground="{StaticResource BrushSuccess}" />
                            <TextBlock Text="Today Attendance" Style="{StaticResource TextBlockSmall}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding DashboardData.TodayAttendance}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="0,0,14,0">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="26" Height="26" Foreground="{StaticResource BrushWarning}" />
                            <TextBlock Text="Unpaid Payments" Style="{StaticResource TextBlockSmall}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding DashboardData.UnpaidPaymentsCount}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrushWarning}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="CashMultiple" Width="26" Height="26" Foreground="{StaticResource BrushInfo}" />
                            <TextBlock Text="Monthly Income" Style="{StaticResource TextBlockSmall}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding DashboardData.MonthlyIncome, StringFormat={}{0:C}}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrushInfo}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardModern}" Background="{StaticResource BrushSurface}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Recent Payments" Style="{StaticResource TextBlockH3}" Margin="16,16,16,10" />
                        <DataGrid CellStyle="{StaticResource DataGridCellModern}" Grid.Row="1"
                                  ItemsSource="{Binding DashboardData.RecentPayments}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  BorderThickness="0"
                                  MinHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Child" Binding="{Binding ChildName}" Width="2*" />
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:C}}" Width="*" />
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:MMM dd, yyyy}}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
