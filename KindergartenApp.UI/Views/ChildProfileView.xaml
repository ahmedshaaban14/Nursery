<UserControl x:Class="KindergartenApp.UI.Views.ChildProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Background="{StaticResource BrushBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource CardModern}"
                Background="{StaticResource BrushSurface}"
                Margin="0,0,20,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="{StaticResource PaddingMD}">
                    <TextBlock Text="Child Profile" Style="{StaticResource TextBlockH3}" Margin="0,0,0,18" />

                    <TextBlock Text="Select Child" Style="{StaticResource TextBlockLabel}" Margin="0,0,0,6" />
                    <ComboBox SelectedItem="{Binding SelectedChild}"
                              ItemsSource="{Binding Children}"
                              DisplayMemberPath="FullName"
                              Style="{StaticResource ComboBoxModern}"
                              Margin="0,0,0,18" />

                    <Border BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            Background="{StaticResource BrushBackground}"
                            Height="200"
                            Margin="0,0,0,18"
                            CornerRadius="4">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountCircleOutline"
                                                     Width="48"
                                                     Height="48"
                                                     Foreground="{StaticResource BrushTextSecondary}"
                                                     Margin="0,0,0,8" />
                            <TextBlock Text="Child Photo"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding UploadPhotoCommand}"
                            Height="42"
                            Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CameraOutline" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="Upload Photo" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding UploadDocumentCommand}"
                            Height="42"
                            Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileUploadOutline" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="Upload Document" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding LoadChildrenCommand}"
                            Style="{StaticResource ButtonSecondary}"
                            Height="42">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardModern}" Background="{StaticResource BrushSurface}" Margin="0,0,0,16">
                <Grid Margin="{StaticResource PaddingMD}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Attendance" Style="{StaticResource TextBlockLabelSmall}" />
                        <TextBlock Text="{Binding AttendancePercentage, StringFormat={}{0:F1}%}"
                                   Style="{StaticResource TextBlockH4}"
                                   Foreground="{StaticResource BrushPrimary}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Total Paid" Style="{StaticResource TextBlockLabelSmall}" />
                        <TextBlock Text="{Binding TotalPaid, StringFormat={}{0:C}}"
                                   Style="{StaticResource TextBlockH4}"
                                   Foreground="{StaticResource BrushSuccess}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="Outstanding" Style="{StaticResource TextBlockLabelSmall}" />
                        <TextBlock Text="{Binding TotalOutstanding, StringFormat={}{0:C}}"
                                   Style="{StaticResource TextBlockH4}"
                                   Foreground="{StaticResource BrushDanger}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Documents" Style="{StaticResource TextBlockLabelSmall}" />
                        <TextBlock Text="{Binding Documents.Count}"
                                   Style="{StaticResource TextBlockH4}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" Background="Transparent">
                <TabItem Header="Documents">
                    <Border Style="{StaticResource CardModern}" Background="{StaticResource BrushSurface}" Padding="0">
                        <DataGrid ItemsSource="{Binding Documents}"
                                  CellStyle="{StaticResource DataGridCellModern}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="2*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding FileType}" Width="*" />
                                <DataGridTextColumn Header="Size" Binding="{Binding FileSizeDisplay}" Width="*" />
                                <DataGridTextColumn Header="Upload Date" Binding="{Binding UploadedAt, StringFormat=yyyy-MM-dd}" Width="*" />
                                <DataGridTemplateColumn Header="Actions" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.DownloadDocumentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ButtonIcon}"
                                                        MinHeight="32"
                                                        MinWidth="32"
                                                        ToolTip="Download">
                                                    <materialDesign:PackIcon Kind="DownloadOutline" Width="17" Height="17" />
                                                </Button>
                                                <Button Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ButtonIcon}"
                                                        MinHeight="32"
                                                        MinWidth="32"
                                                        ToolTip="Delete">
                                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="17" Height="17" Foreground="{StaticResource BrushDanger}" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>

                <TabItem Header="Attendance History">
                    <Border Style="{StaticResource CardModern}" Background="{StaticResource BrushSurface}" Padding="0">
                        <DataGrid ItemsSource="{Binding AttendanceHistory}"
                                  CellStyle="{StaticResource DataGridCellModern}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="*" />
                                <DataGridCheckBoxColumn Header="Present" Binding="{Binding IsPresent}" Width="80" />
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>

                <TabItem Header="Payment History">
                    <Border Style="{StaticResource CardModern}" Background="{StaticResource BrushSurface}" Padding="0">
                        <DataGrid ItemsSource="{Binding PaymentHistory}"
                                  CellStyle="{StaticResource DataGridCellModern}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="*" />
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="*" />
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=C}" Width="*" />
                                <DataGridCheckBoxColumn Header="Paid" Binding="{Binding IsPaid}" Width="70" />
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>